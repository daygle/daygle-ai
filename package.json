{
  "name": "daygle-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "setup": "sh scripts/setup.sh",
    "preflight": "bash scripts/check-debian.sh",
    "ollama:install": "sh scripts/install-ollama.sh",
    "ollama": "sh scripts/run-ollama.sh",
    "vllm:install": "sh scripts/install-vllm.sh",
    "vllm": "sh scripts/install-vllm.sh --serve Qwen/Qwen2.5-Coder-7B-Instruct",
    "agent": "bun run agent/server.ts",
    "test": "bun test",
    "build": "tsc -b && vite build",
    "release": "sh scripts/release.sh",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }

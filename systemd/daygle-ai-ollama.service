[Unit]
Description=Daygle AI - Ollama Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/daygle-ai
ExecStart=/opt/daygle-ai/.ollama/bin/ollama serve
Environment=HOME=/root
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://0.0.0.0:5173
Environment=OLLAMA_MODELS=/opt/daygle-ai/.ollama/models
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

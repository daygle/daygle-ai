[Unit]
Description=Daygle - Ollama Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/daygle-ai
ExecStart=/opt/daygle-ai/.ollama/bin/ollama serve
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_ORIGINS=*
Environment=OLLAMA_MODELS=/opt/daygle-ai/.ollama/models
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

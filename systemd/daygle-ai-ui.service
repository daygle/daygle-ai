[Unit]
Description=Daygle AI - Web UI
After=network.target daygle-ai-ollama.service
Wants=daygle-ai-ollama.service

[Service]
Type=simple
WorkingDirectory=/opt/daygle-ai
ExecStartPre=/root/.bun/bin/bun run build
ExecStart=/root/.bun/bin/bun run preview --port 5173
TimeoutStartSec=300
Environment=HOME=/root
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

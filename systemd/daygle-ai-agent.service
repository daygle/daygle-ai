[Unit]
Description=Daygle AI - Agent Server
After=network.target daygle-ai-ollama.service
Wants=daygle-ai-ollama.service

[Service]
Type=simple
WorkingDirectory=/opt/daygle-ai
ExecStart=/root/.bun/bin/bun run agent
Environment=HOME=/root
Environment=HOST=127.0.0.1
Environment=DAYGLE_UI_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
